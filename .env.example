# ==============================================================================
# AgriMind AI — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local and fill in your own keys.
# All services below have 100% FREE tiers.
# ==============================================================================

# --- App Settings ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# 1. Groq AI (FREE — 30 req/min)
# Sign up: https://console.groq.com/keys
# Powers: Crop Disease Vision Diagnosis, Multilingual Chat, Speech-to-Text Whisper
# ==============================================================================
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_MAX_TOKENS=1500

# ==============================================================================
# 2. MongoDB Atlas (FREE M0 Cluster — 512 MB)
# Sign up: https://cloud.mongodb.com/
# 1. Create a free M0 cluster
# 2. Database Access -> Create user with Read/Write permissions
# 3. Network Access -> Add IP Address: 0.0.0.0/0 (allow from anywhere)
# 4. Connect -> Drivers -> Copy connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/agrimind?retryWrites=true&w=majority
# ==============================================================================
MONGODB_URI=

# ==============================================================================
# 3. Firebase Authentication (FREE — Spark Plan)
# Sign up: https://console.firebase.google.com/
# 1. Create a project
# 2. Build -> Authentication -> Get Started -> Enable "Email/Password" and "Google"
# 3. Project Settings (gear icon) -> General -> Your apps -> Web app (</>) -> Copy config values below:
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ==============================================================================
# 4. Firebase Admin SDK (Server-Side Authentication verification)
# In Firebase Console: Project Settings -> Service accounts -> "Generate new private key"
# Open the downloaded JSON file and copy the values:
# Note: Keep the quotes around FIREBASE_ADMIN_PRIVATE_KEY and keep the \n escaped.
# ==============================================================================
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# 5. Cloudinary Image Storage (FREE — 25 GB)
# Sign up: https://cloudinary.com/users/register_free
# Used for storing crop disease diagnosis photos in MongoDB history.
# Dashboard -> Product Environment Credentials -> Copy Cloud Name, API Key, API Secret:
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================================
# 6. WhatsApp Officer Support (Optional)
# Enter international phone number without '+' (e.g., 919876543210 for India, 9477... for Sri Lanka)
# ==============================================================================
NEXT_PUBLIC_WHATSAPP_SUPPORT=

# ==============================================================================
# 7. Additional Optional Services
# - Weather: Open-Meteo is built-in and free (no API key needed).
#   If you want Google Weather API, add GOOGLE_WEATHER_API_KEY below.
# - Voice TTS: Uses the browser's built-in Web Speech API (100% free, offline).
# - Voice STT: Uses Groq Whisper (free) and browser SpeechRecognition fallback.
# ==============================================================================
GOOGLE_WEATHER_API_KEY=
VALSEA_API_KEY=
